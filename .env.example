# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-please-use-50-chars-min
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://astrovision-frontend.onrender.com

# --- Database ---
POSTGRES_DB=astrovision
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro_dev_pw
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Set to "sqlite" to use SQLite (no Postgres needed for local quickstart)
DB_ENGINE=postgres
# When deploying to Render with a persistent disk:
# DATABASE_URL=sqlite:////app/data/db.sqlite3

# --- Storage paths (override on Render for persistent disk) ---
MEDIA_ROOT=./media
MODEL_DIR=./model_artifacts
# MEDIA_ROOT=/app/data/media
# MODEL_DIR=/app/data/model_artifacts

# --- ML ---
MODEL_WEIGHTS_PATH=model_artifacts/galaxy_cnn.pt
CLASS_MAP_PATH=model_artifacts/class_map.json

# --- External APIs ---
# Get a free key at https://api.nasa.gov/  (DEMO_KEY works but is rate-limited)
NASA_API_KEY=DEMO_KEY

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
# VITE_API_BASE_URL=https://astrovision-backend.onrender.com/api
